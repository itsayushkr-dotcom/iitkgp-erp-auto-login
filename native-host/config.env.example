# ==========================================
# IIT Kharagpur ERP Credentials
# ==========================================
ERP_USER_ID=your_roll_number_here
ERP_PASSWORD=your_erp_password_here

# ==========================================
# 3 Registered Security Questions & Answers
# ==========================================
# Match the questions shown in ERP (wording doesn't have to be 100% exact, fuzzy matching is supported)
SECURITY_Q1=What is the name of your first school?
SECURITY_A1=your_answer_1

SECURITY_Q2=What is your favorite color?
SECURITY_A2=your_answer_2

SECURITY_Q3=What is your mother's maiden name?
SECURITY_A3=your_answer_3

# ==========================================
# Email Configuration for Automatic OTP Fetching
# ==========================================
# Option 1: Gmail / Google Workspace (@kgpian.iitkgp.ac.in or personal Gmail)
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-step verification enabled on your Google account)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=your_email@kgpian.iitkgp.ac.in
IMAP_PASSWORD=your_16_char_app_password

# Option 2: IIT KGP Zimbra Webmail (if you receive ERP OTP on @iitkgp.ac.in directly)
# IMAP_SERVER=iitkgpmail.iitkgp.ac.in
# IMAP_PORT=993
# IMAP_USE_SSL=true
# IMAP_USERNAME=your_username
# IMAP_PASSWORD=your_webmail_password
