{
  "manifest_version": 3,
  "name": "IIT KGP ERP Auto-Login",
  "version": "1.0.0",
  "description": "Zero-click hands-free automated login for IIT Kharagpur ERP with automated email OTP retrieval.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://erp.iitkgp.ac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/SSOAdministration/login.htm*"
      ],
      "js": ["inject_suppress_alert.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://erp.iitkgp.ac.in/SSOAdministration/login.htm*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
